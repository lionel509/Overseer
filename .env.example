# Overseer Environment Configuration
# WARNING: Never commit this file with actual secrets!
# Copy this file to .env and fill in your actual values

# Kaggle API credentials
# Get these from https://www.kaggle.com/account
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Hugging Face authentication token (for private/gated models)
# Get this from https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token

# Gemini API Key (for Google's Gemini models)
# Get this from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Database encryption key
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
OVERSEER_DB_KEY=your_database_encryption_key

# CORS allowed origins (comma-separated)
# For production, set to your actual domain(s)
OVERSEER_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# API Key for securing endpoints (recommended for production)
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
OVERSEER_API_KEY=your_api_key_here

# Security best practices:
# 1. Keep this file in .gitignore (already configured)
# 2. Use strong, randomly generated keys
# 3. Rotate keys regularly
# 4. Use a secrets manager in production
# 5. Never share these credentials
